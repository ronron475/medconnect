# MedConnect AI interpreter (Step 2 medical translation enhancement)
# Copy to system environment or set in XAMPP Apache env / start_ai_service.bat

# ── Database (local XAMPP vs production Hostinger) ─────────────────────────────
# DB_ENV=local|cloud  (auto-detected if unset)
# DB_HOST=localhost                 # XAMPP local
# DB_HOST=localhost                 # PHP on Hostinger (same server as MySQL)
# DB_HOST=srvXXXX.hstgr.io          # Remote MySQL host (only if PHP is off Hostinger)
# DB_NAME=medconnect                # local database name
# DB_NAME=your_production_db_name   # production database name
# DB_USER=root                      # local database user
# DB_USER=your_production_db_user   # production database user
# DB_PASS=
# Local XAMPP ignores DB_* unless DB_ENV=local. Production reads DB_* only.
#
# ── Transactional Email & OTP ─────────────────────────────────────────────────
# NEVER put MAIL_PASSWORD / EMAIL_API_KEY / tokens in PHP source or Git.
#
# Hostinger secrets (pick one; prefer outside public_html):
#   A) Parent .env:  /home/USER/domains/your.tld/.env  (sibling of public_html)
#   B) Private file: /home/USER/private/medconnect.env
#   C) Absolute path via Hostinger/panel env: MEDCONNECT_ENV_FILE=/home/USER/private/medconnect.env
#   D) Optional PHP return-array file (outside public_html):
#        MEDCONNECT_MAIL_CONFIG=/home/USER/private/medconnect_mail.php
#      File contents: <?php return ['MAIL_USERNAME'=>'...','MAIL_PASSWORD'=>'...'];
#
# Production delivery (recommended): Hostinger PHP → Railway /email/send → Resend HTTPS.
# Hostinger shared hosting often blocks outbound SMTP 587/465, so do NOT rely on
# direct Gmail SMTP on Hostinger. Put RESEND_* on Railway only.
#
# Put on Railway: RESEND_API_KEY, MAIL_FROM_EMAIL (verified domain), MAIL_FROM_NAME,
# EMAIL_API_KEY, MEDCONNECT_AI_SERVICE_TOKEN.
# Put on Hostinger: EMAIL_API_KEY + MEDCONNECT_AI_SERVICE_TOKEN (+ AI service URL).
# Same Railway service also hosts OCR (/ocr/extract).
#
# Resend setup (once):
# 1) Create a Resend account and API key (dashboard → API Keys).
# 2) Add + verify a domain you control (DNS SPF/DKIM). Prefer a subdomain, e.g.
#    mail.yourdomain.tld — do NOT use @gmail.com as MAIL_FROM_EMAIL.
# 3) Set MAIL_FROM_EMAIL to an address on that verified domain.
#
# MEDCONNECT_ENV_FILE=
# MEDCONNECT_MAIL_CONFIG=
# RESEND_API_KEY=
# MAIL_FROM_EMAIL=noreply@mail.yourdomain.tld
# MAIL_FROM_NAME=MedConnect Bago City
# EMAIL_API_KEY=
# MEDCONNECT_EMAIL_RELAY_URL=
# MEDCONNECT_AI_SERVICE_TOKEN=
#
# Optional local XAMPP only (PHPMailer direct Gmail SMTP; not for Hostinger production):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# Patient file encryption at rest (AES-256-GCM). Required for residency/ID uploads.
# Prefer a key file outside the web root; never commit the key or store it in storage/.
# Generate: php scripts/security/generate_file_encryption_key.php --out=/path/outside/webroot/file_encryption.key
# Losing the key makes encrypted patient files unrecoverable — back it up separately.
# MEDCONNECT_FILE_ENCRYPTION_KEY_FILE=
# MEDCONNECT_FILE_ENCRYPTION_KEY=

# Base URL override (optional)
# If unset, MedConnect derives the origin from the current request host
# so it works automatically for:
# - http://localhost/medconnect
# - http://192.168.x.x/medconnect
# - https://<ngrok-subdomain>.ngrok-free.app/medconnect
# - https://your-production-domain.tld
#
# Example (required for production video on phones):
# MEDCONNECT_APP_URL=https://your-domain.tld/medconnect
MEDCONNECT_APP_URL=

# Trust reverse-proxy headers for scheme/host detection (ngrok, cloud proxies).
# Set to false only if you are behind an untrusted proxy that can spoof headers.
MEDCONNECT_TRUST_PROXY=true
# Login IP limits read X-Forwarded-For only when REMOTE_ADDR matches this list
# (IPs or CIDRs). Leave empty on a direct Hostinger/XAMPP connection.
# MEDCONNECT_TRUSTED_PROXIES=127.0.0.1,::1

# Session SameSite policy: Lax (recommended), Strict, or None (requires HTTPS).
MEDCONNECT_SESSION_SAMESITE=Lax

# Session cookie name (isolates MedConnect from other PHP apps on the same host).
MEDCONNECT_SESSION_NAME=MEDCONNECT_SESSION

# Primary: Groq (openai/gpt-oss-120b — replaces llama-3.3-70b-versatile, shutdown 2026-08-16)
GROQ_API_KEY=

# Optional: OpenAI fallback
OPENAI_API_KEY=

# Optional: local Llama via Ollama
MEDCONNECT_LOCAL_LLAMA_URL=http://127.0.0.1:11434
MEDCONNECT_LOCAL_LLAMA_MODEL=llama3

# Campus BITS Ollama (language assist / Gemini quota fallback only — never sets triage)
MEDCONNECT_BITS_SERVICE=1
MEDCONNECT_BITS_SERVICE_URL=https://bits-service.bagocitycollege.com
MEDCONNECT_BITS_OLLAMA_MODEL=phi3:mini
MEDCONNECT_BITS_SERVICE_TIMEOUT=60

# Provider order (comma-separated): groq, openai, bits, local
MEDCONNECT_AI_PROVIDER_ORDER=groq,openai,bits,local

# Set to 0 to disable AI layer (dictionary-only translation)
MEDCONNECT_AI_INTERPRETER=1

MEDCONNECT_GROQ_MODEL=openai/gpt-oss-120b
# Optional faster model for demo/registration NLP:
# MEDCONNECT_GROQ_MODEL=openai/gpt-oss-20b
MEDCONNECT_OPENAI_MODEL=gpt-4o-mini
MEDCONNECT_AI_INTERPRETER_TIMEOUT=25

# Python AI microservice (required for NLP demo — no silent PHP fallback when REQUIRE_PYTHON=true)
# Local: http://127.0.0.1:8765
# Production (medconnect.bccbsis.com): auto-defaults to Railway in config/app.php if unset
# MEDCONNECT_AI_SERVICE_URL=https://medconnect-production-ab04.up.railway.app
MEDCONNECT_AI_SERVICE_URL=http://127.0.0.1:8765
# Shared secret for protected Railway AI routes (POST /gemini/generate and the other AI endpoints).
# Set the same value on Railway and on this PHP host. Never commit a real value.
# MEDCONNECT_AI_SERVICE_TOKEN=
MEDCONNECT_AI_SERVICE_ENABLED=true
# Local: true. Production host auto-defaults to false in config/app.php
MEDCONNECT_AI_AUTO_START=true
MEDCONNECT_AI_HEALTH_TIMEOUT=3
MEDCONNECT_AI_ANALYZE_TIMEOUT=120
# When true (default), analyze API returns 503 instead of PHP fallback if Python is unavailable
MEDCONNECT_AI_REQUIRE_PYTHON=true

# ── WebRTC consultation room ICE servers ──────────────────────────────────────
# STUN alone cannot traverse the symmetric NAT used by most mobile carriers, so
# phone participants may connect on Wi-Fi but fail on mobile data without TURN.
# Leave USERNAME/CREDENTIAL blank to run STUN-only (fine on a shared LAN).
# Free TURN: https://www.metered.ca/stun-turn — generate a credential, then paste it.
MEDCONNECT_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478,stun:stun.relay.metered.ca:80
MEDCONNECT_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
MEDCONNECT_TURN_USERNAME=
MEDCONNECT_TURN_CREDENTIAL=

# ── FAQ chatbot conversational AI fallback (optional, free-tier) ───────────────
# Used ONLY when the existing FAQ/KB/emergency engine is not confident.
# Never put these keys in JavaScript.
# Local XAMPP: PHP can call Gemini directly with AI_API_KEY.
# Production: Hostinger PHP calls Railway /faq-chatbot/assist (put the Gemini key on Railway).
# Canonical key order (PHP + Python): AI_API_KEY → GEMINI_API_KEY → GOOGLE_API_KEY.
# Never put these keys in JavaScript or browser-facing responses.
AI_ENABLED=true
AI_PROVIDER=gemini
# Optional: campus BITS Ollama as the interview LLM only (same Gemini system/user JSON schema).
# ClinicalTriageEngine still assigns EMERGENCY / URGENT / NON-URGENT. Default remains gemini.
# AI_PROVIDER=bits
AI_API_KEY=
# Optional alias if you prefer Google's variable name:
# GEMINI_API_KEY=
# Current free-tier chat models include gemini-3.5-flash (Standard) and gemini-3.5-flash-lite (higher free RPD).
# gemini-2.5-flash is closed to many new API projects.
# AI_MODEL must start with "gemini" for Gemini clients (non-gemini values fall back to gemini-3.5-flash).
AI_MODEL=gemini-3.5-flash-lite
# Clinical interview demo only (gemini_clinical_interview_demo.php).
# Used after Gemini HTTP 429 / quota exceeded. Does not set triage.
# Fixed free model in PHP: google/gemma-4-31b-it:free
# Railway then tries Groq (GROQ_API_KEY) if OpenRouter is missing or down.
# OPENROUTER_API_KEY=
AI_MAX_HISTORY=12
AI_TIMEOUT=15
AI_COOLDOWN_SECONDS=2
AI_MAX_REQUESTS_PER_HOUR=25
# Optional second provider: set AI_PROVIDER=groq and reuse GROQ_API_KEY, or set AI_API_KEY.
# Groq free-tier example: llama-3.1-8b-instant
# AI_PROVIDER=groq
# AI_MODEL=llama-3.1-8b-instant
# Local XAMPP only if PHP curl cannot verify HTTPS (issuer certificate error).
# Keep true (default) on Hostinger/production.
# AI_SSL_VERIFY=false

# Keep Gemini on unless you intentionally disable it:
MEDCONNECT_PHP_NLP_ONLY=false
MEDCONNECT_SKIP_GEMINI_VALIDATION=false
MEDCONNECT_SKIP_GEMINI_SELECT=false
MEDCONNECT_SKIP_GEMINI_FOLLOWUP=false
# Optional: skip Gemini semantic complaint validation (PHP domain gate only).
# MEDCONNECT_SKIP_GEMINI_VALIDATION=true
# Optional: skip Gemini adaptive question SELECT (keep bank/policy + optional phrasing).
# MEDCONNECT_SKIP_GEMINI_SELECT=true
# Optional: skip Gemini follow-up phrasing (question bank only).
# MEDCONNECT_SKIP_GEMINI_FOLLOWUP=true
# Optional: disable all Gemini usage for NLP (validation + follow-up phrasing).
# MEDCONNECT_PHP_NLP_ONLY=true
# Optional: additive Python ai_service enrichment in clinical interview (default on when AI service enabled).

# ── Cohere Rerank (Care Tips matching only) ───────────────────────────────────
# Ranks existing self_care_remedies.csv entries when local CSV/NLP match is weak.
# Does NOT generate, rewrite, diagnose, or prescribe Care Tip text.
# Provider approval remains required before tips are shown to patients.
#
# Preferred production setup: put COHERE_API_KEY on Railway only.
# Hostinger PHP will call Railway POST /care-tips/rerank (same pattern as Gemini).
# Optional local/direct key for XAMPP without Railway:
COHERE_API_KEY=
COHERE_RERANK_ENABLED=true
COHERE_RERANK_MODEL=rerank-v3.5
# Minimum relevance score (0–1) to accept a Cohere-ranked CSV tip.
COHERE_RERANK_MIN_SCORE=0.45
# Does NOT replace PHP triage. Set false to force PHP-only even if Python is online.
# MEDCONNECT_CLINICAL_PYTHON_ENRICH=true
# MEDCONNECT_CLINICAL_PYTHON_TIMEOUT=6

# ── NLP Step 3 demo interview API (public demo page) ───────────────────────────
# Browser clients must load nlp_step3_demo.php (issues CSRF + session demo token).
# Optional shared key for scripted HTTP clients (never embed in frontend JS):
# NLP_DEMO_API_KEY=
# Max Gemini-calling turns per IP per hour on the demo interview endpoint (default 20).
# NLP_DEMO_GEMINI_MAX_PER_HOUR=20

# FastAPI OCR — unified on main AI service (port 8765)
# MEDCONNECT_OCR_SERVICE_URL defaults to MEDCONNECT_AI_SERVICE_URL
MEDCONNECT_OCR_SERVICE_ENABLED=true
MEDCONNECT_OCR_TIMEOUT=90
# OCR.Space key — server/.env only (never commit a real value; never put in PHP/JS)
OCR_SPACE_API_KEY=
# Local debug only (exposes parsed OCR text in JSON). Keep 0/false in production.
OCR_DEBUG=0

# TextBee follow-up SMS. Keep SEND disabled until you explicitly allow live messages.
# Dashboard: https://textbee.dev  API: POST /api/v1/gateway/send-sms with header x-api-key.
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# TEXTBEE_API_BASE=https://api.textbee.dev
# TEXTBEE_SEND_ENABLED=false
